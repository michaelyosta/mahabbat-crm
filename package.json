{
  "name": "mahabbat",
  "version": "0.9.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  },
  "keywords": [],
  "packageManager": "yarn@4.13.0",
  "files": [
    "manifest.json",
    "README.md",
    "src/**/*.mjs"
  ],
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "typecheck": "tsgo --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:dry": "node scripts/seed-demo.mjs --dry-run",
    "seed:pos": "node scripts/seed-pos.mjs",
    "seed:pos:dry": "node scripts/seed-pos.mjs --dry-run",
    "cleanup:pos:review-fixtures": "node scripts/cleanup-pos-review-fixtures.mjs",
    "seed:inventory:review": "node scripts/seed-inventory-human-review.mjs",
    "verify-runtime-api-parity": "node scripts/verify-runtime-api-parity.mjs",
    "identity:smoke": "node scripts/identity-import-smoke.mjs",
    "aggregate-sales:smoke": "node scripts/aggregate-sales-smoke.mjs",
    "pos:gateway": "node pos-standalone/server/gateway.mjs",
    "pos:print-gateway": "node pos-standalone/server/print-gateway.mjs",
    "pos:web:dev": "vite --config pos-standalone/web/vite.config.ts",
    "pos:web:build": "vite build --config pos-standalone/web/vite.config.ts",
    "pos:dev": "node pos-standalone/dev.mjs",
    "pos:deploy:build": "docker build -f pos-standalone/Dockerfile -t mahabbat-pos-gateway:local .",
    "test:pos:standalone": "node --test pos-standalone/server/__tests__/gateway.test.mjs",
    "test:printing": "node --test pos-standalone/server/__tests__/printing.test.mjs pos-standalone/server/__tests__/print-gateway.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.29.0",
    "twenty-sdk": "2.29.0",
    "twenty-ui": "1.0.0-alpha.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  }
}
