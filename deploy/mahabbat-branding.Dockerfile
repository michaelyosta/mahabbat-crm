# Thin deployment overlay for the pinned Twenty v2.29.0 image.
# The App SDK does not own document/OG/PWA metadata. This overlay keeps the
# exact upstream runtime and database behavior while changing only the
# deployment-facing product title and share metadata to MAHABBAT.
FROM twentycrm/twenty:v2.29.0

RUN node -e 'const fs=require("fs"); const path=require("path"); const front="/app/packages/twenty-server/dist/front"; const htmlFile=path.join(front,"index.html"); let html=fs.readFileSync(htmlFile,"utf8"); html=html.replaceAll("A modern open-source CRM","MAHABBAT CRM — ресторанная CRM для Казахстана").replaceAll("<meta property=\"og:title\" content=\"Twenty\" />","<meta property=\"og:title\" content=\"MAHABBAT CRM\" />").replaceAll("<meta name=\"twitter:title\" content=\"Twenty\" />","<meta name=\"twitter:title\" content=\"MAHABBAT CRM\" />").replaceAll("<title>Twenty</title>","<title>MAHABBAT CRM</title>").replaceAll("https://raw.githubusercontent.com/twentyhq/twenty/main/docs/static/img/social-card.png",""); fs.writeFileSync(htmlFile,html); const manifestFile=path.join(front,"manifest.json"); const manifest=JSON.parse(fs.readFileSync(manifestFile,"utf8")); manifest.short_name="MAHABBAT"; manifest.name="MAHABBAT CRM"; fs.writeFileSync(manifestFile,JSON.stringify(manifest,null,2)); const assets=path.join(front,"assets"); for (const name of fs.readdirSync(assets)) { if (!name.endsWith(".js")) continue; const file=path.join(assets,name); const before=fs.readFileSync(file,"utf8"); const after=before.replaceAll("default:return\"Twenty\"","default:return\"MAHABBAT CRM\""); if (after !== before) fs.writeFileSync(file,after); }'
