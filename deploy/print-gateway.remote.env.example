# TEMPORARY DEVELOPMENT BRIDGE — restaurant Windows PC only.
# Copy to a private ignored file such as .private\print-gateway.remote.env.
# This file is not a permanent production topology.

# HTTPS origin of the home Mahabbat backend. A private VPN HTTPS origin is
# also valid; do not point this at a printer address or publish TCP 9100.
TWENTY_API_URL=https://<home-mahabbat-origin>
PRINT_GATEWAY_MODE=REMOTE

# Must match the private app-side route secret. Never commit this value.
MAHABBAT_INTERNAL_ROUTE_SECRET=<same-private-secret-as-home-app>

# Keep the bridge control endpoint local to this restaurant PC.
PRINT_GATEWAY_HOST=127.0.0.1
PRINT_GATEWAY_PORT=3110
PRINT_GATEWAY_POLL_MS=1500
PRINT_GATEWAY_CONNECT_TIMEOUT_MS=5000
PRINT_GATEWAY_AUTO_RETRY_LIMIT=2
PRINT_GATEWAY_ID=restaurant-soft-group-8256

# Required only when the selected home HTTPS origin is behind Cloudflare
# Access. Create/use a narrowly scoped service token; never put it in Git or
# a browser. Leave both values absent when a private authenticated origin is
# used instead.
# CLOUDFLARE_ACCESS_CLIENT_ID=<local-private-value>
# CLOUDFLARE_ACCESS_CLIENT_SECRET=<local-private-value>
