# Local-only Ethernet ESC/POS gateway. Keep this file out of source control when populated.
TWENTY_API_URL=http://127.0.0.1:3000
MAHABBAT_INTERNAL_ROUTE_SECRET=replace-with-the-same-secret-used-by-the-app
PRINT_GATEWAY_HOST=0.0.0.0
PRINT_GATEWAY_PORT=3110
PRINT_GATEWAY_POLL_MS=1500
PRINT_GATEWAY_CONNECT_TIMEOUT_MS=5000
PRINT_GATEWAY_AUTO_RETRY_LIMIT=2
# Optional stable id. Do not reuse the same id for two simultaneously running gateways.
# PRINT_GATEWAY_ID=front-desk-pc-01
