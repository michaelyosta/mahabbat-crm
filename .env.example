# Safe template only. Replace placeholders through a private environment.

TWENTY_API_URL=http://localhost:2020
TWENTY_API_KEY=<local-disposable-api-key>
MAHABBAT_API_URL=http://localhost:2020
MAHABBAT_API_KEY=<local-disposable-api-key>
MAHABBAT_INTERNAL_ROUTE_SECRET=<generate-a-private-random-secret>

# Optional local POS provisioning/acceptance inputs; never commit real PINs.
MAHABBAT_POS_SEED_WAITER_PIN=<private-4-to-8-digit-pin>
MAHABBAT_POS_SEED_ADMIN_PIN=<private-4-to-8-digit-pin>
MAHABBAT_POS_PIN_A=<private-pos-session-pin>
MAHABBAT_POS_PIN_B=<private-pos-session-pin>

SERVER_URL=http://localhost:3000
STORAGE_TYPE=local
LOGIC_FUNCTION_TYPE=LOCAL
ENCRYPTION_KEY=<private-runtime-encryption-key>
FALLBACK_ENCRYPTION_KEY=<optional-private-fallback-key>

# Standalone POS gateway (LAN / self-hosted)
POS_GATEWAY_PORT=3100
POS_CORS_ORIGIN=*
# gateway credentials are server-only: never expose to browser bundle
# TWENTY_API_URL=http://server:3000 (inside Docker) or http://localhost:3000 (local)
# MAHABBAT_API_KEY / TWENTY_API_KEY used by gateway service identity
